{
  "schemaVersion": 1,
  "id": "himelib",
  "version": "${version}",
  "name": "HimeLib",
  "description": "The animation engine of Hime: a fork of GeckoLib 4.8.3 (MIT) under its own name, so it runs beside GeckoLib.",
  "authors": [
    "Marcos"
  ],
  "contributors": [
    "GeckoLib: Gecko, Eliot, AzureDoom, DerToaster, Tslat, Witixin"
  ],
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.cuddly.himelib.GeckoLib"
    ],
    "client": [
      "com.cuddly.himelib.GeckoLibClient"
    ]
  },
  "mixins": [
    "himelib.mixins.json"
  ],
  "accessWidener": "himelib.accesswidener",
  "depends": {
    "fabricloader": ">=0.17",
    "fabric-api": ">=0.100.0+1.21",
    "java": ">=21",
    "minecraft": ">=1.21.1"
  },
  "custom": {
    "modmenu": {
      "badges": [
        "library"
      ]
    }
  }
}
